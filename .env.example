# ── Database (Neon) ─────────────────────────────────────────
# Use the POOLED connection string (host contains "-pooler").
# Added automatically when you connect Neon from Vercel → Storage.
DATABASE_URL=postgresql://neondb_owner:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ── Auth ────────────────────────────────────────────────────
# Signs session cookies and file links. Generate with: openssl rand -base64 48
AUTH_SECRET=
# Customer sign-ups must confirm their email (as on Supabase). Set "false" to skip.
AUTH_REQUIRE_EMAIL_CONFIRMATION=true

# ── File storage (Vercel Blob, private store) ──────────────
# Added automatically when you create a Blob store in Vercel → Storage.
BLOB_READ_WRITE_TOKEN=

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://alagawellness.care
RESEND_API_KEY=
ANTHROPIC_API_KEY=
CRON_SECRET=
HITPAY_API_KEY=
HITPAY_SALT=
NEXT_PUBLIC_HITPAY_MODE=sandbox
